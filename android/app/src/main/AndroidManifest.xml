<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Requis par `image_picker` (fiche personnage, upload de portrait) pour
         la prise de photo (la sélection en galerie passe par le sélecteur
         photo système, sans permission dédiée sur les versions d'Android
         récentes). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Requis par `speech_to_text` (dictée vocale du bouton micro de
         l'onglet "Notes" de l'écran "Groupe",
         `features/groups/presentation/widgets/group_notes_tab_body.dart`). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Identifiant publicitaire : ajouté automatiquement par Firebase
         Analytics (play-services-measurement), jamais utilisé par l'app (aucune
         publicité). Retiré pour rester conforme à la politique de
         confidentialité et à la déclaration Google Play ("aucun identifiant
         publicitaire"). Voir aussi `google_analytics_adid_collection_enabled`
         plus bas. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove"/>
    <application
        android:label="Nexus JDR"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Analytics produit (`core/analytics/`, décision chef de projet
             RGPD) : coupe la collecte automatique de Firebase Analytics au
             niveau natif dès le démarrage du process, avant même que
             `lib/main.dart` n'ait pu lire la préférence locale "Partager mes
             données d'usage" et appeler explicitement
             `FirebaseAnalytics.instance.setAnalyticsCollectionEnabled(...)`
             — sans ce `meta-data`, la collecte automatique par défaut du SDK
             (activée par défaut) pourrait capturer un événement avant que
             ce garde applicatif ne s'applique. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link universel "Rejoindre une histoire"
                 (nexus-jdr.app/join/{code}), voir
                 `docs/cahier-des-charges/04-fonctionnalites-app-mobile.md`
                 section 7.1 et la route `/join/:code`
                 (`core/router/app_router.dart`, câblage go_router déjà
                 fait).

                 IMPORTANT — configuration native INCOMPLÈTE : ce bloc seul
                 fait fonctionner le lien si l'app est déjà installée et que
                 le lien est ouvert alors qu'aucune autre app ne revendique
                 le même hôte/chemin (comportement de repli d'Android sans
                 vérification), mais `android:autoVerify="true"` ne devient
                 réellement effectif (lien qui ouvre l'app directement sans
                 passer par un sélecteur d'app, "Android App Links") qu'une
                 fois qu'un fichier `.well-known/assetlinks.json` est publié
                 sur https://nexus-jdr.app, listant le nom de package de
                 cette app (`applicationId`, voir `android/app/build.gradle`)
                 et l'empreinte SHA-256 du certificat de signature utilisé
                 pour les builds distribués (debug ET release, généralement
                 deux entrées) — non fait ici : pas de clé de signature de
                 production ni d'accès au serveur nexus-jdr.app depuis ce
                 dépôt mobile, à coordonner avec qui gère ce domaine (dépôt
                 web) et la publication sur les stores (`13-depot-versioning-publication.md`).
                 Signalé au chef de projet plutôt que présenté comme fini. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="nexus-jdr.app"
                    android:pathPrefix="/join"/>
            </intent-filter>
            <!-- Deep link universel "Partage en lecture seule d'un
                 personnage" (nexus-jdr.app/p/{token}), voir
                 `docs/cahier-des-charges/12-partage-et-groupes.md` section 1
                 et la route `/p/:token` (`core/router/app_router.dart`,
                 câblage go_router déjà fait, exempté du mur
                 d'authentification — voir `computeAuthRedirect`).

                 Même bloc que l'intent-filter "/join" ci-dessus, même
                 caveat de configuration native INCOMPLÈTE (voir son
                 commentaire pour le détail : `android:autoVerify="true"` ne
                 devient réellement effectif qu'une fois
                 `.well-known/assetlinks.json` publié sur
                 https://nexus-jdr.app, non fait ici pour la même raison). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="nexus-jdr.app"
                    android:pathPrefix="/p"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Rend explicite ce qui est déjà le comportement par défaut de
             Flutter (voir https://docs.flutter.dev/ui/navigation/deep-linking)
             plutôt que de le laisser implicite, maintenant que ce dépôt a un
             vrai cas d'usage de deep link (voir l'intent-filter ci-dessus). -->
        <meta-data
            android:name="flutter_deeplinking_enabled"
            android:value="true" />
        <!-- Firebase Analytics : ne jamais collecter l'identifiant publicitaire
             (voir les permissions AD_ID retirées en tête de fichier). -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Requis par `url_launcher` (`canLaunchUrl`) pour "Contacter le
             support" de l'écran "Aide et support"
             (`features/profile/presentation/profile_help_screen.dart`) :
             sans cette déclaration, Android 11+ (API 30+) masque tout
             résultat de résolution d'intent aux apps qui n'ont pas déclaré
             la requête correspondante, et `canLaunchUrl` retournerait
             systématiquement `false` pour une URI `mailto:` même si un
             client e-mail est installé. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <!-- Requis par `speech_to_text` sur Android 11+ (API 30+) : sans
             cette déclaration, aucun moteur de reconnaissance vocale
             (`SpeechRecognizer.isRecognitionAvailable`) n'est visible à
             l'app, même s'il y en a un installé sur l'appareil. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
