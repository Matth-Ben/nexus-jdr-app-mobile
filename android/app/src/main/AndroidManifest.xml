<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Requis par `image_picker` (fiche personnage, upload de portrait) pour
         la prise de photo (la sélection en galerie passe par le sélecteur
         photo système, sans permission dédiée sur les versions d'Android
         récentes). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <application
        android:label="personnages"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link universel "Rejoindre une histoire"
                 (nexus-jdr.app/join/{code}), voir
                 `docs/cahier-des-charges/04-fonctionnalites-app-mobile.md`
                 section 7.1 et la route `/join/:code`
                 (`core/router/app_router.dart`, câblage go_router déjà
                 fait).

                 IMPORTANT — configuration native INCOMPLÈTE : ce bloc seul
                 fait fonctionner le lien si l'app est déjà installée et que
                 le lien est ouvert alors qu'aucune autre app ne revendique
                 le même hôte/chemin (comportement de repli d'Android sans
                 vérification), mais `android:autoVerify="true"` ne devient
                 réellement effectif (lien qui ouvre l'app directement sans
                 passer par un sélecteur d'app, "Android App Links") qu'une
                 fois qu'un fichier `.well-known/assetlinks.json` est publié
                 sur https://nexus-jdr.app, listant le nom de package de
                 cette app (`applicationId`, voir `android/app/build.gradle`)
                 et l'empreinte SHA-256 du certificat de signature utilisé
                 pour les builds distribués (debug ET release, généralement
                 deux entrées) — non fait ici : pas de clé de signature de
                 production ni d'accès au serveur nexus-jdr.app depuis ce
                 dépôt mobile, à coordonner avec qui gère ce domaine (dépôt
                 web) et la publication sur les stores (`13-depot-versioning-publication.md`).
                 Signalé au chef de projet plutôt que présenté comme fini. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="nexus-jdr.app"
                    android:pathPrefix="/join"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Rend explicite ce qui est déjà le comportement par défaut de
             Flutter (voir https://docs.flutter.dev/ui/navigation/deep-linking)
             plutôt que de le laisser implicite, maintenant que ce dépôt a un
             vrai cas d'usage de deep link (voir l'intent-filter ci-dessus). -->
        <meta-data
            android:name="flutter_deeplinking_enabled"
            android:value="true" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
